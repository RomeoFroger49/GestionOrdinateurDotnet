{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "route-ordinateurs": {
        "ClusterId": "cluster-gestion-api",
        "Match": {
          "Path": "/api/Ordinateurs/{**catch-all}"
        }
      },
      "route-reparations": {
        "ClusterId": "cluster-gestion-api",
        "Match": {
          "Path": "/api/Reparation/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "cluster-gestion-api": {
        "Destinations": {
          "gestion-api": {
            "Address": "http://localhost:5087/"
          }
        }
      }
    }
  }
}
