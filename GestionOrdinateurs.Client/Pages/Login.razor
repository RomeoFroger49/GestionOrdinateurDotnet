@page "/login"
@using GestionOrdinateurs.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Connexion</PageTitle>

<h3>Connexion</h3>

<form @onsubmit="Connecter" style="max-width: 400px;">
    <div class="mb-3">
        <label class="form-label" for="login">Utilisateur</label>
        <input id="login" class="form-control" @bind="login" @bind:event="oninput" placeholder="user1" autocomplete="username" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="motDePasse">Mot de passe</label>
        <input id="motDePasse" type="password" class="form-control" @bind="motDePasse" @bind:event="oninput" autocomplete="current-password" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@enCours">
        @(enCours ? "Connexion..." : "Connecter")
    </button>
</form>

@if (erreur is not null)
{
    <div class="alert alert-danger mt-3" style="max-width: 400px;">@erreur</div>
}

@code {
    private string login = "";
    private string motDePasse = "";
    private string? erreur;
    private bool enCours;

    private async Task Connecter()
    {
        enCours = true;
        erreur = await AuthService.ConnecterAsync(login, motDePasse);
        enCours = false;

        if (erreur is null)
        {
            Navigation.NavigateTo("/");
        }
    }
}
